# Port the server listens on (Render and similar hosts set this for you).
PORT=10000

# Optional: an Unsplash "Access Key" from https://unsplash.com/developers
# With it, every workout card shows a real Unsplash photo that matches the exercise.
# Without it, the cards show built-in illustrations instead.
UNSPLASH_ACCESS_KEY=

# Optional: only let these sites call the API (comma-separated). Empty = any site.
CORS_ORIGIN=
